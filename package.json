{
  "name": "flocki-web-app",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "start-server-and-test preview http://127.0.0.1:4173/ 'cypress open --e2e'",
    "test:e2e:ci": "start-server-and-test preview http://127.0.0.1:4173/ 'cypress run --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@websanova/vue-auth": "^4.2.1",
    "axios": "^1.21.0",
    "cropperjs": "^1.7.0",
    "dayjs": "^1.11.23",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "pinia": "^2.3.1",
    "pinia-orm": "^1.10.2",
    "vue": "^3.5.44",
    "vue-cropperjs": "^5.0.0",
    "vue-router": "^5.4.0",
    "vue-skeletor": "^1.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/leaflet": "^1.9.22",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^16.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-cypress": "^7.0.3",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "pug": "^3.0.4",
    "sass": "^1.107.1",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-eslint-parser-template-tokenizer-pug": "^1.0.0",
    "vue-tsc": "^3.3.14"
  }
}
